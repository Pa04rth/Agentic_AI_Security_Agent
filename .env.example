# ============================================================
#  SECRETS — copy this file to ".env" and fill in real values.
#  NEVER commit the real .env (it is in .gitignore).
#  In GitHub Actions, set each of these as a repository Secret instead.
# ============================================================

# --- Google Gemini (AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash   # fast + cheap. Use gemini-2.5-pro for max quality.

# --- YouTube Data API v3 (Google Cloud Console > APIs & Services) ---
YOUTUBE_API_KEY=

# --- Notion (control + storage layer) -----------------------------------
# 1) Create an internal integration: https://www.notion.so/my-integrations
#    -> copy the "Internal Integration Secret" into NOTION_API_KEY.
# 2) Create a Notion page to hold the databases, open its ... menu ->
#    Connections -> add your integration so it has access.
# 3) Copy that page's ID (32-char hex in the page URL) into NOTION_PARENT_PAGE_ID.
# 4) Run:  python src/setup_notion.py   (creates + seeds all 4 databases)
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=        # only needed for the one-time setup_notion.py run

# --- WhatsApp completion alert via CallMeBot (FREE) ---------------------
# One-time setup (2 minutes, no app/account):
#   1) Save the number +34 644 51 95 23 to your phone contacts as "CallMeBot"
#   2) Send this WhatsApp message to it:  "I allow callmebot to send me messages"
#   3) You'll receive an API key. Paste it below along with your phone number.
# Leave blank to silently skip the WhatsApp ping (email still sends).
WHATSAPP_PHONE=                        # e.g. +919876543210  (with country code)
CALLMEBOT_APIKEY=

# --- Optional: Semantic Scholar API key (raises rate limits; works without) ---
SEMANTIC_SCHOLAR_API_KEY=
